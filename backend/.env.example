# ------------------------------------------------------------------
# Copy this file to "backend/.env" and fill in the values.
# NEVER commit .env to git or put these values in frontend code.
# ------------------------------------------------------------------

# Port for the local website (http://localhost:5000)
PORT=5000

# Name of this laptop / assessor team (shown in the email so
# you know whose laptop sent it). Do NOT put a child's name here.
STATION_NAME=Laptop-1

# ---------------- Email notification ----------------
# true  = send an email after every submission
# false = never send email (data is still saved locally)
ENABLE_EMAIL=true

# Who receives the email. Several addresses can be separated by commas.
ADMIN_EMAIL=

# true = attach the session.json and audio recordings (zipped) to the email
# false = send a short notification only (audio stays on the laptop)
EMAIL_ATTACH_AUDIO=true

# Maximum attachment size per email in MB. Recordings larger than this are
# split across several emails ("Part 1 of 3", ...). Gmail's limit is 25 MB
# including encoding overhead, so 15 is a safe value.
EMAIL_MAX_ATTACHMENT_MB=15

# SMTP server settings. For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your.project.account@gmail.com
#   SMTP_PASSWORD=<16-character Google App Password, NOT your normal password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Sender address shown in the email (defaults to SMTP_USERNAME if empty)
EMAIL_FROM=
